	"description": "",
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"argon2": "^0.45.1",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"jose": "^6.2.10",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^12.1.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/supertest": "^7.2.1",
		"eslint": "^9.39.5",
