generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

model City {
    id Int @id @default(autoincrement())
    name String 
    state String?
    country String
    lat Float 
    lon Float
    
    searchHistories SearchHistory[]
    favorites Favorite[]

    @@unique([lat, lon], name: "lat_lon")
}

model User {
    id Int @id @default(autoincrement())
    username String @unique

    searchHistories SearchHistory[]
    favorites Favorite[]
}

model SearchHistory {
    id Int @id @default(autoincrement())
    userId Int 
    cityId Int
    searchedAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id])
    city City @relation(fields: [cityId], references: [id])

    @@unique([userId, cityId], name: "userId_cityId")
}

model Favorite {
    id Int @id @default(autoincrement())
    userId Int
    cityId Int
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id])
    city City @relation(fields: [cityId], references: [id])

    @@unique([userId, cityId], name: "userId_cityId")
}
